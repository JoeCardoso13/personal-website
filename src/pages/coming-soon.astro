---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Coming Soon - Joe Cardoso">
  <div class="container">
    <img src="/under-construction.svg" alt="Under construction" />
    <p>This post isn't live yet. Check back soon.</p>
    <a href="#" onclick="history.back(); return false;" class="back-link">← go back</a>
  </div>
</Layout>

<style>
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 4rem 0;
  }

  p {
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .back-link {
    color: var(--accent);
    font-size: 0.95rem;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>
